# =============================================================================
# GemiX — copy to .env and fill every uncommented key.
# Same keys as src/config/env.js (REQUIRED[] + optional exports).
# Commented lines = optional; default applied by env.js if omitted.
# =============================================================================

# --- xAI main model — required only when AI_PROVIDER=xai ---------------------
GROK_MODEL=

# --- OpenRouter (music via Lyria) — required --------------------------------
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
MUSIC_MODEL=
MUSIC_STATS_URL=
MUSIC_WRAP_URL=

# --- xAI media models — required only when AI_PROVIDER=xai -------------------
# VIDEO_GEN_MODEL: grok-imagine-video ($0.050/sec) or grok-imagine-video-1.5
# ($0.080/sec). 1.5 adds 1080p on text/image-to-video, duration up to 15s and
# reference-to-video; every parameter generate_video sends is supported by both.
IMAGE_GEN_MODEL=
VIDEO_GEN_MODEL=

# --- People (prompts / tools) — required -------------------------------------
ADMIN_NAME=
LEGAL_NAME=

# --- Discord — required --------------------------------------------------------
BOT_TOKEN=
GUILD_ID=

# --- Email (Gmail SMTP) — required ---------------------------------------------
BOT_EMAIL=
BOT_PASS=

# --- Music wrap + GitHub — required --------------------------------------------
MUSIC_WRAP_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=

# --- Infra URLs — required -----------------------------------------------------
GEMIX_NOTIFY_URL=
GEMIX_PUBLIC_ATTACHMENT_BASE_URL=
GEMIX_TEMP_FILE_PORT=
# GEMIX_NOTIFY_SECRET=
# (if omitted, POST /notify has no secret check; if set, same value on the sandbox proxy container)
# GEMIX_NOTIFY_BIND=127.0.0.1
# (address POST /notify listens on; set it to the Docker bridge gateway, e.g.
#  172.17.0.1, so the sandbox proxy container can deliver its alerts)

# --- Main-brain provider profile — optional (default xai) ----------------------
# AI_PROVIDER=xai
# (xai | chatgpt | openrouter | custom — composes transport + credentials + feature bindings)
# CHATGPT_MODEL=
# (required when AI_PROVIDER=chatgpt; e.g. gpt-5.6-terra)
# CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex
# OPENROUTER_MAIN_MODEL=
# (required when AI_PROVIDER=openrouter; the main-brain model, not MUSIC_MODEL)
# CUSTOM_RESPONSES_BASE_URL=
# CUSTOM_RESPONSES_API_KEY=
# CUSTOM_RESPONSES_MODEL=
# (all three required when AI_PROVIDER=custom)

# --- Native OAuth — optional (only for the OAuth pools) ------------------------
# Credentials live in data/credentials/<pool>.json (0600), managed by
# `npm run auth -- login|import|list|remove`. The bot refreshes them in-process;
# no external CLI is involved at runtime.
# The xAI endpoints have no published defaults, so an xAI OAuth login needs all
# three set (not needed when XAI_USE_API_KEY=true).
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_AUTHORIZE_URL=
# XAI_OAUTH_TOKEN_URL=
# XAI_OAUTH_SCOPE=offline_access
# XAI_OAUTH_REDIRECT_URI=http://127.0.0.1:8976/callback
# The ChatGPT (Codex) values below are the published client defaults; override
# only if OpenAI changes them.
# CHATGPT_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# CHATGPT_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# CHATGPT_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# CHATGPT_OAUTH_SCOPE=openid profile email offline_access
# CHATGPT_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback

# --- Feature flags — optional (defaults in env.js) -----------------------------
# XAI_USE_API_KEY=false
# MAINTENANCE_MODE=false
# STARTUP_SYSTEM_CLEANUP=false
# Media generation quota reset (Europe/Rome). Hour/minute apply to the daily cap
# (images) and the weekly ones (videos, songs); the weekday only to the weekly.
# Defaults: Monday (1) at 00:00.
# MEDIA_QUOTA_RESET_WEEKDAY=1
# (0=Sunday … 6=Saturday)
# MEDIA_QUOTA_RESET_HOUR=0
# (0–23)
# MEDIA_QUOTA_RESET_MINUTE=0
# (0–59; wording in the Runtime block / tool errors follows HH:MM)

# --- Cloudflare Workers AI — optional ------------------------------------------
# Whisper STT for user voice notes and FLUX for generate_image. On the xAI
# profile these are the fallback behind the provider back ends; on the others
# they are the only ones. Both draw on the same free daily neuron allowance
# (10,000 neurons per account, reset at 00:00 UTC). Unset, STT and Cloudflare
# image generation are simply unavailable.
# Both are comma-separated lists and are paired positionally: the nth account id
# goes with the nth token. Add a pair to raise the daily ceiling — GemiX works
# through the accounts one at a time and rotates when one is spent for the day.
# Rotate these before deploy; never commit real values.
# CLOUDFLARE_AI_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# XAI_STT_PATH=
# (xAI speech-to-text endpoint path, e.g. /audio/transcriptions. No default: xAI
#  publishes none, so with this unset STT resolves to Cloudflare Whisper.)

# --- Text-to-speech — optional -------------------------------------------------
# Cartesia Sonic is the primary voice backend on every provider profile, with
# Microsoft Edge (no credential needed) as the fallback behind it. Each Cartesia
# account carries its own monthly free credit allowance, so CARTESIA_API_KEYS is
# a comma-separated pool: GemiX uses one key at a time, records the spent ones
# and rotates to the next, and drops to Microsoft Edge once the whole pool is
# spent for the month. Add more keys to the list to extend the pool.
# Rotate these before deploy; never commit real values.
# CARTESIA_API_KEYS=
# CARTESIA_BASE_URL=https://api.cartesia.ai
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VERSION=2026-08-14
# TTS_VOICE=male
# (starting voice for a chat that never set one: male or female)

# --- Paths / sandbox — optional ------------------------------------------------
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# LOG_LEVEL=info
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
# TESSERACT_PATH=tesseract
# (OCR for scanned PDFs and photos, driven by read_file. Without it those
#  pages come back as rendered images with no extracted text.)
# GEMIX_SANDBOX_IMAGE=gemix-sandbox:latest
# GEMIX_SANDBOX_NETWORK=gemix_sandbox_net  # prefix for per-workspace internal networks
# GEMIX_SANDBOX_PROXY_HOST=gemix-sandbox-proxy
# GEMIX_SANDBOX_PROXY_PORT=8080
# Local SearXNG for search_image (default http://127.0.0.1:8888; see image-search/)
# SEARCH_IMAGE_BASE_URL=http://127.0.0.1:8888
# agent-search sidecar over the same SearXNG, serving search_web and read_page
# (default http://127.0.0.1:3939; same stack). Set the token only if you gave
# the sidecar one; unset means no Authorization header.
# AGENT_SEARCH_BASE_URL=http://127.0.0.1:3939
# AGENT_SEARCH_TOKEN=
# CHROMIUM_PATH=
# (browser for WhatsApp Web. Unset, Puppeteer's own downloaded Chrome is used —
#  do NOT point this at Ubuntu's /usr/bin/chromium, which is a confined snap)
