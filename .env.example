# =============================================================================
# GemiX — copy to .env and fill every uncommented key.
# Same keys as src/config/env.js (REQUIRED[] + optional exports).
# Commented lines = optional; default applied by env.js if omitted.
# =============================================================================

# --- Core AI (direct xAI API) — required -------------------------------------
GROK_MODEL=

# --- AI provider selection — optional (default xai) ----------------------------
# Which back end GemiX runs on: xai | openai. Always explicit — never inferred
# from a model name. Switching it back to xai is the full rollback.
# AI_PROVIDER=xai

# --- ChatGPT/OpenAI profile — required when AI_PROVIDER=openai -----------------
# Same shape as GROK_MODEL above: required with the profile active, ignored
# otherwise. Auth is the Hermes `openai-codex` pool, exactly as xAI uses
# `xai-oauth`; the wake request uses whatever model Hermes is configured with.
OPENAI_MODEL=
# OPENAI_AUTH_FILE=
# (Hermes auth.json holding the openai-codex pool; defaults to ~/.hermes/auth.json)
# OPENAI_BASE_URL=https://chatgpt.com/backend-api/codex

# --- OpenRouter (music via Lyria) — required --------------------------------
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
MUSIC_MODEL=
MUSIC_STATS_URL=
MUSIC_WRAP_URL=

# --- xAI media models — required ---------------------------------------------
# VIDEO_GEN_MODEL: grok-imagine-video ($0.050/sec) or grok-imagine-video-1.5
# ($0.080/sec). 1.5 adds 1080p on text/image-to-video, duration up to 15s and
# reference-to-video; every parameter generate_video sends is supported by both.
IMAGE_GEN_MODEL=
VIDEO_GEN_MODEL=

# --- People (prompts / tools) — required -------------------------------------
ADMIN_NAME=
LEGAL_NAME=

# --- Discord — required --------------------------------------------------------
BOT_TOKEN=
GUILD_ID=

# --- Email (Gmail SMTP) — required ---------------------------------------------
BOT_EMAIL=
BOT_PASS=

# --- Music wrap + GitHub — required --------------------------------------------
MUSIC_WRAP_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=

# --- Infra URLs — required -----------------------------------------------------
GEMIX_NOTIFY_URL=
GEMIX_PUBLIC_ATTACHMENT_BASE_URL=
GEMIX_TEMP_FILE_PORT=
# GEMIX_NOTIFY_SECRET=
# (if omitted, POST /notify has no secret check; if set, same value on the sandbox proxy container)

# --- Feature flags — optional (defaults in env.js) -----------------------------
# XAI_USE_API_KEY=false
# MAINTENANCE_MODE=false
# STARTUP_SYSTEM_CLEANUP=false
# XAI_TTS_ENABLED=false
# XAI_TTS_VOICE=leo
# XAI_REASONING_REPLAY=true
# Weekly media generation quota reset (Europe/Rome). Defaults: Monday (1) at 00:00.
# MEDIA_WEEKLY_RESET_WEEKDAY=1
# (0=Sunday … 6=Saturday)
# MEDIA_WEEKLY_RESET_HOUR=0
# (0–23)
# MEDIA_WEEKLY_RESET_MINUTE=0
# (0–59; wording in the Runtime block / tool errors follows HH:MM)

# --- Cloudflare Workers AI (OpenAI profile) — optional -------------------------
# Whisper STT for user voice notes and FLUX for generate_image — on this profile
# Workers AI is the only image back end, not a fallback. Both draw on the same
# free daily neuron allowance, so GemiX meters them with one shared ledger.
# Rotate these before deploy; never commit real values.
# CLOUDFLARE_AI_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# --- Paths / sandbox — optional ------------------------------------------------
# XAI_AUTH_FILE=
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# HERMES_BIN=hermes
# (Hermes CLI path; used to refresh OAuth tokens in ~/.hermes/auth.json when they expire)
# HERMES_REFRESH_TIMEOUT_MS=120000
# HERMES_REFRESH_QUERY=ciao
# HERMES_REFRESH_PROVIDER=xai-oauth
# CODEX_BROKER_HOST=gemix-codex-broker
# CODEX_BROKER_PORT=8081
# CODEX_BROKER_BIND=127.0.0.1
# (host-side auth broker the sandbox reaches through the egress proxy: it swaps a
#  single-use ticket for the real bearer, which never enters the container.
#  BIND is loopback like the notify server; expose it to the egress gateway with
#  a socat relay, never by binding the broker to every interface. HOST is the
#  name the sandbox asks the proxy for and must match CODEX_BROKER_NAME there)
# LOG_LEVEL=info
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
# GEMIX_SANDBOX_IMAGE=gemix-sandbox:latest
# GEMIX_SANDBOX_NETWORK=gemix_sandbox_net
# GEMIX_SANDBOX_PROXY_HOST=gemix-sandbox-proxy
# GEMIX_SANDBOX_PROXY_PORT=8080
# Local SearXNG for web_image_search (default http://127.0.0.1:8888; see image-search/)
# IMAGE_SEARCH_BASE_URL=http://127.0.0.1:8888
# CHROMIUM_PATH=/usr/bin/chromium
